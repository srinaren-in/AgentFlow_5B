# AgentFlow Environment Configuration Template

# Database (PostgreSQL for Docker/Production, SQLite for Local Dev)
DATABASE_URL=postgresql://agentflow:agentflow_secret@localhost:5432/agentflow_db
# Local SQLite default (used if DATABASE_URL is not set): sqlite:///./agentflow.db

# Authentication Security
JWT_SECRET_KEY=your_secure_random_jwt_secret_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configurations
GEMINI_API_KEY=your_google_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# CORS & Server Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost"]
PORT=8000
HOST=0.0.0.0

